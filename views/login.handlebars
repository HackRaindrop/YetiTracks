<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>YetiTracks</title>
  <link rel="shortcut icon" href="/assets/img/favicon.png" />
  <link rel="stylesheet" type="text/css" href="/assets/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
</head>

<body style="background-image: url(/assets/img/backgroundIMG.jpg); background-size: cover">
  <nav>
    <a href="/login" class="brand-link">
      <img id="logo" src="/assets/img/yeti.png" alt="yeti logo" />
      <span class="brand-name">YetiTracks</span>
    </a>
    <div class="navlink"><a id="loginButton" href="/login">Login</a></div>
    <div class="navlink"><a id="signupButton" href="/signup">Sign up</a></div>
  </nav>

  <div class="hero-section">
    <img src="/assets/img/yeti.png" alt="YetiTracks Mascot" class="hero-yeti" />
    <h1 class="hero-title">Welcome to YetiTracks</h1>
    <p class="hero-subtitle">Track your ski runs, analyze your performance, conquer the mountain.</p>
  </div>

  <section id="content">

  </section>

  <div id="skiMessage" class='hidden'>
    <img id="speech" src="/assets/img/speech.png" alt="speech box" />
    <h3><span id="errorMessage"></span></h3>
    <img id="yeti" src="assets/img/yeti.png" alt="yeti mascot" />
  </div>
  <footer>
    <a href="https://www.flaticon.com/free-icons/yeti" title="yeti icons">Yeti icons created by Freepik - Flaticon</a>
  </footer>
  <script src="/assets/loginBundle.js"></script>
</body>

</html>